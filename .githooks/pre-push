#!/usr/bin/env bash
# Pre-push hook: when pushing to main, automatically bump the patch version
# (e.g. 0.1.0 -> 0.1.1) UNLESS Cargo.toml was already manually modified in
# the pushed commits. The bump is squashed into the tip commit via
# `git commit --amend` — no extra commit is created in the history.
#
# If the developer already changed Cargo.toml (e.g. a manual version bump),
# the hook skips entirely.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# Skip for a single push with:  git push --no-verify

set -euo pipefail

# Pre-push stdin format: "<local_ref> <local_sha> <remote_ref> <remote_sha>"
while read -r local_ref local_sha remote_ref remote_sha; do
    # Only act on pushes to main
    if [ "$remote_ref" != "refs/heads/main" ]; then
        continue
    fi

    # Determine the range of commits being pushed
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # No upstream yet (e.g. first push of a new branch) — look at HEAD's changes
        if ! git rev-parse --verify HEAD~1 >/dev/null 2>&1; then
            # Initial commit: just inspect the whole tree
            range="$(git hash-object -t tree /dev/null 2>/dev/null || echo 4b825dc642cb6eb9a060e54bf8d69288fbee4904)..HEAD"
        else
            range="HEAD~1..HEAD"
        fi
    else
        range="${remote_sha}..${local_sha}"
    fi

    # If Cargo.toml was manually modified in the pushed commits, the developer
    # already handled versioning — skip the auto-bump entirely.
    if git diff --name-only "$range" -- Cargo.toml | grep -q '^Cargo\.toml$'; then
        echo "info: Cargo.toml was modified in the pushed commits — skipping auto version bump."
        continue
    fi

    # Cargo.toml untouched: auto-bump the patch version.

    # Read the current version (e.g. "0.1.0")
    current=$(grep -m1 '^version =' Cargo.toml | sed -E 's/.*"([^"]+)".*/\1/')
    if [ -z "$current" ]; then
        echo "error: could not parse version from Cargo.toml" >&2
        exit 1
    fi

    # Validate and split
    if ! [[ "$current" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)([-+][0-9A-Za-z.-]*)?$ ]]; then
        echo "error: unexpected version format in Cargo.toml: $current" >&2
        exit 1
    fi
    major="${BASH_REMATCH[1]}"
    minor="${BASH_REMATCH[2]}"
    patch="${BASH_REMATCH[3]}"

    new_patch=$((10#$patch + 1))
    new_version="${major}.${minor}.${new_patch}"

    # Replace the package `version = "..."` line in Cargo.toml. Dependency
    # versions in Cargo.toml are inline (e.g. `dioxus = { version = "0.7.1" }`),
    # so the `^version` anchor naturally restricts the substitution to the
    # package itself.
    sed -i -E "s/^version = \"[^\"]+\"/version = \"${new_version}\"/" Cargo.toml

    # Update the matching `version = "..."` line in Cargo.lock, but only
    # inside the `[[package]]` block whose `name = "krynon"` (this package).
    # Dependency entries are left untouched.
    awk -v new_version="${new_version}" '
        /^name = "krynon"$/ { found=1; print; next }
        found && /^version = / {
            sub(/"[^"]+"/, "\"" new_version "\"")
            found=0
        }
        { print }
    ' Cargo.lock > Cargo.lock.tmp && mv Cargo.lock.tmp Cargo.lock

    # Sanity check: confirm Cargo.toml actually changed
    if git diff --quiet -- Cargo.toml; then
        echo "warning: version bump resulted in no change (already at ${new_version}?)" >&2
        continue
    fi

    echo "Bumping version: ${current} -> ${new_version} (amending tip commit)"

    git add Cargo.toml Cargo.lock
    # Amend the tip commit to include the version bump — no extra commit in history.
    # --no-verify prevents the hook from recursing on the amend.
    git commit --amend --no-edit --no-verify
done

# Always allow the push to proceed; git will use the updated ref state
# (which now includes the amended commit) when it actually pushes.
exit 0
