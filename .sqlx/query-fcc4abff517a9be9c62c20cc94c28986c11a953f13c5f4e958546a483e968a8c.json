  "query": "\n        SELECT c.id, c.name, c.description, c.emoji\n        FROM criteria c\n        JOIN category_criteria cc ON c.id = cc.criterion_id\n        WHERE cc.category_id = $1\n        ORDER BY c.name\n        ",
